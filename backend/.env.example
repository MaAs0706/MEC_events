# NEXUS backend environment variables.
# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL / Supabase connection string.
# DATABASE_URL=postgresql://user:password@host:5432/database
# Conservative SQLAlchemy connection pool settings for Supabase Session Pooler.
# DB_POOL_SIZE=3
# DB_MAX_OVERFLOW=2
# DB_POOL_RECYCLE_SECONDS=1800

# Public address of this FastAPI app. Used when returning uploaded image URLs.
# PUBLIC_API_URL=https://api.nexus.example.com

# Cloudinary media storage. Obtain these from Cloudinary Console > API Keys.
# Keep API_SECRET on the backend only; never put it in a frontend .env file.
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# JWT signing key. Use a long random string in production.
# SECRET_KEY=change-me

# Browser session cookies. Keep the default development values locally. In
# production use HTTPS and set APP_ENV=production + SESSION_COOKIE_SECURE=true.
# For frontend/api on different sites, use SESSION_COOKIE_SAMESITE=none only
# with HTTPS. A shared college domain is preferable.
# APP_ENV=development
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_SAMESITE=lax
# SESSION_COOKIE_DOMAIN=

# Shared rate limiting. Set these for every multi-worker/production deployment.
# Use a TLS Redis URL in production (for example, Upstash). REQUIRE_REDIS=true
# makes the API reject rate-limited operations rather than fall back locally.
# REDIS_URL=rediss://default:password@host:6379
# REQUIRE_REDIS=false

# JWT signing algorithm.
ALGORITHM=HS256

# Transactional email, sent by Resend. This sends password recovery links and
# review alerts to active approvers/admins when an event is submitted. Create
# an API key in Resend and verify the sender domain before production. Keep
# these backend-only.
# RESEND_API_KEY=re_your_api_key
# RESEND_FROM_EMAIL=NEXUS <noreply@your-college-domain.edu>
# FRONTEND_URL=https://nexus.your-college-domain.edu

# Comma-separated list of allowed browser origins (CORS).
# In production, list the deployed frontend origin(s):
# CORS_ORIGINS=https://app.nexus.example.com,https://www.nexus.example.com
# Unset -> defaults to the local Vite dev origins.
